# ==============================================================================
# Vectis Control Center - Root .gitignore
# ==============================================================================

# --- Environment & Secret Configuration ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Python Virtual Environments ---
venv/
.venv/
env/
ENV/
agent/venv/
agent/.venv/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# --- SQLite Databases & Journals ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
vps_control.db*
agent/vps_control.db*

# --- Testing & Quality Tools ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Dependencies ---
node_modules/
frontend/node_modules/

# --- Next.js Build Outputs ---
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
*.tsbuildinfo
.vercel/

# --- Logs & Debugging ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Hallmark / Local Customization Cache ---
.hallmark/
