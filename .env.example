# ==============================================================================
# VPS Control Center - Environment Configuration Template
# Copy this file to .env and configure secrets before production deployment
# ==============================================================================

# Backend Agent Host and Port (Default listens only on localhost for security)
AGENT_HOST="127.0.0.1"
AGENT_PORT=8000

# Secret API Key for direct agent integrations
AGENT_API_KEY="generate-a-secure-random-token-here"

# Path to SQLite database file
DATABASE_PATH="vps_control.db"

# Allowed CORS origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3050,http://127.0.0.1:3050"

# Metrics sampling interval in seconds
METRICS_INTERVAL=3

# Server-Side Permitted Systemd Services (comma-separated, exact unit base names)
# Frontend cannot modify or bypass this allowlist.
SERVICE_ALLOWLIST="nginx,ssh,sshd,docker,cron,ufw,mysql,postgresql,ollama,redis,systemd-journald"

# Administrator Credentials
ADMIN_USERNAME="admin"
# Bcrypt hash of administrator password (default is for "admin123")
# Generate your own hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH="$2b$12$OWde5hNSe2FmLm9rcBhfgeV5AIOZzG0hjZEoxqCHRqCD9dCK7y0Ka"

# JWT Token Secret and Parameters
JWT_SECRET_KEY="generate-a-long-random-secret-key-for-jwt-signing"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database metrics retention window in hours
DATA_RETENTION_HOURS=48

# Frontend Public API URL (optional override if frontend connects directly)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
